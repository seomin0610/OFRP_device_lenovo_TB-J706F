on early-init
    mkdir /dev/cpuset
    mount cpuset none /dev/cpuset nodev noexec nosuid
    mkdir /dev/cpuset/foreground
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/foreground/mems 0
    chmod 0666 /dev/cpuset/foreground/tasks
    chmod 0666 /dev/cpuset/tasks
    mkdir /dev/cgroup_info

on init
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.configfs 1
    setprop service.adb.root 1

on property:ro.boot.usbcontroller=*
    setprop sys.usb.controller ${ro.boot.usbcontroller}
    write /sys/class/udc/${ro.boot.usbcontroller}/device/../mode peripheral
    setprop sys.usb.config adb

on property:ro.debuggable=1
    start adbd

on fs
    wait /dev/block/platform/soc/1d84000.ufshc
    symlink /dev/block/platform/soc/1d84000.ufshc /dev/block/bootdevice
    mkdir /dev/cgroup_info
    copy /system/etc/cgroup.rc /dev/cgroup_info/cgroup.rc
    chmod 0644 /dev/cgroup_info/cgroup.rc    
    chmod 0660 /dev/qseecom
    chown system drmrpc /dev/qseecom
    chmod 0664 /dev/ion
    chown system system /dev/ion
    symlink /dev/binderfs/vndbinder /dev/vndbinder
    chmod 0666 /dev/binder
    chmod 0666 /dev/hwbinder
    chmod 0666 /dev/vndbinder
    start hwservicemanager
    start qseecomd
    exec u:r:recovery:s0 -- /system/bin/sleep 2
    start keystore2
    exec u:r:recovery:s0 -- /system/bin/sleep 3
    start adbd

service qseecomd /vendor/bin/qseecomd
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64:/vendor/lib:/system/lib
    disabled
    oneshot
    seclabel u:r:recovery:s0

service vendor.keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service-qti
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

service vendor.keymaster-4-1 /vendor/bin/hw/android.hardware.keymaster@4.1-service-qti
    user root
    group root drmrpc
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/system/lib64:/system/lib:/sbin
    disabled
    seclabel u:r:recovery:s0

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    user root
    group keystore readproc log
    disabled
    seclabel u:r:recovery:s0

on property:init.svc.qseecomd=stopped
    start vendor.keymaster-4-0
    start vendor.keymaster-4-1

on property:hwservicemanager.ready=true
    start qseecomd

on property:ro.crypto.state=encrypted
    start qseecomd
